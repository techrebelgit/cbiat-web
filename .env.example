# Membership application email delivery
# Create an API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxx

# Must be a sender/domain verified in your Resend account.
# Example: CBIAT <formularios@cbiat.org>
CBIAT_FORM_FROM_EMAIL="CBIAT <formularios@cbiat.org>"

# Optional. Defaults to info@cbiat.org.
CBIAT_FORM_TO_EMAIL=info@cbiat.org
